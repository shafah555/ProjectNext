# Server
PORT=5000
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────
# DATABASE CONNECTION — Neon Postgres
#
# This uses Neon's pooled connection string (host contains "-pooler"),
# which is required on Render's free tier / any serverless-style host.
#
# Get your exact pooler URL from:
#   Neon console → your project → Connection Details → "Pooled connection"
#
# IMPORTANT: this .env file is only used for LOCAL development. On Render,
# this value must ALSO be set manually in Dashboard → your service →
# Environment tab (render.yaml marks DATABASE_URL as sync:false, so Render
# will NOT pick this value up automatically from the repo).
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:npg_knV12sSfBqMz@ep-raspy-salad-ax4xn7ig-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT
JWT_SECRET=85d85ab2f97f5668b5a21397d8388b9f
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins — NO trailing slash
CLIENT_ORIGIN=https://project-next-lovat.vercel.app